<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.paulino.icloud-reminders-mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-T</string>
    <string>-n</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>IdentitiesOnly=yes</string>
    <string>-o</string><string>StrictHostKeyChecking=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-i</string><string>{{SSH_KEY}}</string>
    <string>localhost</string>
    <string>reminders-mcp</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>{{HOME}}</string>
    <key>PATH</key><string>{{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>REMINDERS_EVENTKIT_NO_PROMPT</key><string>1</string>
  </dict>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>WorkingDirectory</key><string>{{REPO_ROOT}}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{{LOG_DIR}}/mcp.out.log</string>
  <key>StandardErrorPath</key><string>{{LOG_DIR}}/mcp.err.log</string>
</dict>
</plist>
